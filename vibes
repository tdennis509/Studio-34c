<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio 34C - Watercolor Modern Instrumentals</title>
    <!-- Load Tailwind CSS --><script src="https://cdn.tailwindcss.com"></script>
    <!-- Use a modern, artistic font family for headings and body --><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Raleway:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        /* Custom scrollbar for dark mode */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f7f3f0; /* Lighter background for the scrollbar track */
        }
        ::-webkit-scrollbar-thumb {
            background: #b16c5c; /* Muted watercolor-like accent */
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #cd8a77;
        }

        body {
            font-family: 'Raleway', sans-serif; /* Modern body font */
            background-color: #f7f3f0; /* Very light, almost off-white background */
            color: #333; /* Dark text for contrast */
            line-height: 1.6;
            /* Combine your image with the watercolor SVG */
            background-image: 
                url(''), /* Your image will go here, encoded as base64 */
                url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><defs><filter id="watercolor-filter" x="-50%" y="-50%" width="200%" height="200%"><feTurbulence type="fractalNoise" baseFrequency="0.01 0.05" numOctaves="3" result="noise"/><feDiffuseLighting in="noise" lightingColor="white" surfaceScale="10" result="diffuse"><feDistantLight azimuth="225" elevation="45"/></feDiffuseLighting><feComposite in="SourceGraphic" in2="diffuse" operator="arithmetic" k1="1" k2="0" k3="0" k4="0"/></filter></defs><rect width="100%" height="100%" fill="%23f7f3f0"/><g filter="url(%23watercolor-filter)"><path fill="%23e0c0b8" opacity="0.4" d="M0 0C100 50 200 100 300 150L300 0Z"/><path fill="%23c19e8e" opacity="0.3" d="M1000 1000C900 950 800 900 700 850L700 1000Z"/><circle cx="200" cy="300" r="150" fill="%23e0c0b8" opacity="0.5"/><circle cx="800" cy="700" r="180" fill="%23c19e8e" opacity="0.4"/><path fill="%23f0d4cc" opacity="0.6" d="M0 500C150 400 300 600 500 500C700 400 850 600 1000 500L1000 1000L0 1000Z"/></g></svg>');
            background-size: cover, cover; /* Ensure both images cover the space */
            background-repeat: no-repeat, no-repeat;
            background-position: center center, center center; /* Center both */
            background-attachment: fixed, fixed; /* Keep both fixed */
            background-blend-mode: soft-light, normal; /* Blend your image with soft-light mode */
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif; /* Elegant heading font */
        }
    </style>
    <script>
        // Tailwind config with updated watercolor-inspired color palette
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'primary-light': '#f7f3f0',     /* Very light background, paper-like */
                        'secondary-light': '#ffffff',   /* Pure white for cards, contrasts with primary */
                        'text-dark': '#333333',         /* Dark text for readability */
                        'accent-watercolor': '#b16c5c', /* Muted reddish-brown, like dried watercolor */
                        'accent-dark': '#8e5e52',       /* Darker shade for hover/active states */
                        'soft-gray': '#e0dcd9',         /* Soft separator lines, subtle contrast */
                        'dark-overlay': 'rgba(0,0,0,0.1)' /* Slightly darker overlay for text readability */
                    },
                }
            }
        }

        // --- JavaScript for Playback and Interaction ---

        document.addEventListener('DOMContentLoaded', () => {
            const trackList = [
                { id: 'track1', name: 'Drifting Petals', genre: 'Lofi / Chillwave', bpm: 80, price: '$24.99' },
                { id: 'track2', name: 'Crimson Tide', genre: 'Ambient / Cinematic', bpm: 65, price: '$44.99' },
                { id: 'track3', name: 'Urban Canvas', genre: 'Hip Hop / Soul', bpm: 92, price: '$34.99' },
                { id: 'track4', name: 'Skyline Sketch', genre: 'Electronic / Future', bpm: 120, price: '$29.99' },
                { id: 'track5', name: 'Echoes in Water', genre: 'Downtempo / Chill', bpm: 75, price: '$19.99' },
                { id: 'track6', name: 'Ink & Rhythm', genre: 'Trap / Experimental', bpm: 145, price: '$39.99' }
            ];

            const player = document.getElementById('audioPlayer');
            const currentTrackName = document.getElementById('currentTrackName');
            const buyButton = document.getElementById('buyButton');
            let isPlaying = false;
            let currentTrackId = null;

            // Simple function to simulate playing audio since we don't have actual files
            const simulatePlay = (track) => {
                if (currentTrackId === track.id && isPlaying) {
                    // Stop playing
                    player.pause();
                    isPlaying = false;
                    currentTrackId = null;
                    currentTrackName.textContent = 'Select a track to preview...';
                    buyButton.classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    // Start playing new track
                    player.play(); // Simulate play
                    isPlaying = true;
                    currentTrackId = track.id;
                    currentTrackName.textContent = `Now Playing: ${track.name}`;
                    buyButton.classList.remove('opacity-50', 'cursor-not-allowed');
                }

                // Update play/pause buttons visually
                document.querySelectorAll('.play-btn').forEach(btn => {
                    const icon = btn.querySelector('.play-icon');
                    const pauseIcon = btn.querySelector('.pause-icon');
                    
                    if (btn.dataset.trackId === track.id && isPlaying) {
                        icon.classList.add('hidden');
                        pauseIcon.classList.remove('hidden');
                        btn.classList.add('bg-accent-dark', 'text-white');
                        btn.classList.remove('bg-soft-gray', 'text-accent-watercolor');
                    } else {
                        icon.classList.remove('hidden');
                        pauseIcon.classList.add('hidden');
                        btn.classList.remove('bg-accent-dark', 'text-white');
                        btn.classList.add('bg-soft-gray', 'text-accent-watercolor');
                    }
                });
            };

            // Initialize track cards and add listeners
            const instrumentalsContainer = document.getElementById('instrumentalsContainer');
            trackList.forEach(track => {
                const card = document.createElement('div');
                card.className = 'bg-secondary-light p-6 rounded-2xl shadow-lg transition duration-300 hover:scale-[1.02] hover:shadow-xl hover:shadow-accent-watercolor/20 group border border-soft-gray hover:border-accent-watercolor';
                card.innerHTML = `
                    <div class="flex flex-col h-full">
                        <h3 class="text-3xl font-bold text-text-dark mb-2">${track.name}</h3>
                        <p class="text-accent-watercolor text-md font-semibold uppercase tracking-wider mb-4">${track.genre}</p>
                        
                        <div class="flex items-center text-gray-500 text-sm mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1 text-accent-watercolor" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.414-1.414L11 9.586V6z" clip-rule="evenodd" />
                            </svg>
                            ${track.bpm} BPM
                        </div>

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-soft-gray">
                            <span class="text-3xl font-extrabold text-accent-dark">${track.price}</span>
                            <button data-track-id="${track.id}" class="play-btn flex items-center justify-center w-14 h-14 rounded-full bg-soft-gray text-accent-watercolor transition duration-150 transform hover:scale-105 shadow-md">
                                <!-- Play Icon --><svg class="play-icon w-7 h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                                </svg>
                                <!-- Pause Icon (Hidden by default) --><svg class="pause-icon w-7 h-7 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    </div>
                `;
                instrumentalsContainer.appendChild(card);
            });

            // Add global click listener for play buttons
            document.querySelectorAll('.play-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const track = trackList.find(t => t.id === btn.dataset.trackId);
                    if (track) {
                        simulatePlay(track);
                    }
                });
            });
            
            // Initial state for the global Buy button
            buyButton.classList.add('opacity-50', 'cursor-not-allowed');

            // Simulate the audio player
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioCtx.createOscillator();
            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(440, audioCtx.currentTime); // A4
            oscillator.connect(audioCtx.destination);

            player.play = () => {
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                // In a real scenario, you would load and play the audio here.
                // Here, we just visually update the UI.
            };
            player.pause = () => {
                // In a real scenario, you would pause the audio here.
            };

            // Handle the global Buy button click
            buyButton.addEventListener('click', () => {
                if (currentTrackId) {
                    const track = trackList.find(t => t.id === currentTrackId);
                    // In a real application, this would initiate checkout
                    showMessage(`Added "${track.name}" to cart!`);
                    // Stop simulated playback after "purchase"
                    simulatePlay(track);
                }
            });

            // Function to show a custom message box instead of alert()
            function showMessage(message) {
                const messageBox = document.getElementById('messageBox');
                const messageText = document.getElementById('messageText');
                
                messageText.textContent = message;
                messageBox.classList.remove('hidden');
                messageBox.classList.add('flex');

                // Auto-hide after 3 seconds
                setTimeout(() => {
                    messageBox.classList.add('hidden');
                    messageBox.classList.remove('flex');
                }, 3000);
            }
        });
    </script>
</head>

<body class="min-h-screen">

    <!-- Custom Message Box (Replaces alert()) --><div id="messageBox" class="hidden fixed top-0 left-0 right-0 z-50 p-4 bg-green-500/90 text-white shadow-xl justify-center items-center rounded-b-lg">
        <p id="messageText" class="text-lg font-semibold"></p>
    </div>

    <!-- Header / Navigation --><header class="sticky top-0 z-40 bg-secondary-light/80 backdrop-blur-md shadow-sm border-b border-soft-gray">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <a href="#" class="text-4xl font-extrabold tracking-wide text-text-dark">
                STUDIO <span class="text-accent-watercolor">34C</span>
            </a>
            <nav class="hidden md:flex space-x-10">
                <a href="#instrumentals" class="text-gray-600 hover:text-accent-watercolor transition duration-150 font-medium text-lg">Beats</a>
                <a href="#about" class="text-gray-600 hover:text-accent-watercolor transition duration-150 font-medium text-lg">Licensing</a>
                <a href="#contact" class="text-gray-600 hover:text-accent-watercolor transition duration-150 font-medium text-lg">Contact</a>
            </nav>
            <a href="#" class="md:hidden p-2 rounded-full hover:bg-soft-gray transition">
                <!-- Shopping Cart Icon (Lucide Icon Placeholder) --><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-watercolor"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 12.08a2 2 0 0 0 2 1.92h11.24a2 2 0 0 0 2-1.92L23 6H6"/></svg>
            </a>
        </div>
    </header>

    <main>
        <!-- Hero Section --><section class="relative pt-24 pb-32 text-center overflow-hidden">
            <div class="max-w-4xl mx-auto px-4">
                <h1 class="text-6xl sm:text-8xl font-extrabold leading-tight mb-6 text-text-dark">
                    Artistry in <span class="text-accent-watercolor block md:inline-block">Every Beat.</span>
                </h1>
                <p class="text-2xl text-gray-700 mb-10 max-w-2xl mx-auto font-light">
                    Handcrafted instrumentals that inspire, elevate, and define your sound. Discover unique sonic canvases.
                </p>
                <div class="flex flex-col sm:flex-row justify-center space-y-5 sm:space-y-0 sm:space-x-6">
                    <a href="#instrumentals" class="px-10 py-4 bg-accent-watercolor hover:bg-accent-dark text-white font-bold rounded-full transition duration-300 shadow-xl shadow-accent-watercolor/30 transform hover:scale-105 text-lg">
                        Explore Soundscapes
                    </a>
                    <a href="#contact" class="px-10 py-4 bg-secondary-light text-text-dark font-bold rounded-full border border-soft-gray hover:border-accent-watercolor transition duration-300 transform hover:scale-105 text-lg">
                        Custom Commissions
                    </a>
                </div>
            </div>
            <!-- Abstract background graphic (more subtle watercolor style) --><div class="absolute inset-0 z-[-1] opacity-50">
                <svg width="100%" height="100%" viewBox="0 0 1440 800" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="200" cy="150" rx="180" ry="120" fill="#e0c0b8" opacity="0.4"/>
                    <ellipse cx="1200" cy="650" rx="220" ry="160" fill="#c19e8e" opacity="0.3"/>
                    <path d="M0 400C300 150 700 750 1440 400V800H0V400Z" fill="#f0d4cc" opacity="0.6"/>
                </svg>
            </div>
        </section>

        <!-- Global Audio Player / Controls --><section class="sticky bottom-0 z-30 bg-secondary-light/90 backdrop-blur-sm shadow-2xl border-t border-soft-gray">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row justify-between items-center">
                <div class="text-center md:text-left mb-3 md:mb-0">
                    <p class="text-sm font-medium text-gray-500">Currently Playing</p>
                    <p id="currentTrackName" class="text-xl font-semibold text-text-dark">Select a track to preview...</p>
                </div>
                
                <div class="flex items-center space-x-5 w-full md:w-auto">
                    <!-- Placeholder Audio Player (hidden, used for logic) --><audio id="audioPlayer" src="" preload="auto"></audio>
                    
                    <!-- Progress Bar Placeholder --><div class="w-full md:w-72 h-3 bg-soft-gray rounded-full">
                        <div class="w-1/3 h-full bg-accent-watercolor rounded-full transition-all duration-500"></div>
                    </div>

                    <!-- Global Buy Button --><button id="buyButton" class="px-8 py-3 bg-accent-watercolor text-white font-bold rounded-xl transition duration-300 hover:bg-accent-dark shadow-md">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 inline-block mr-2" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.435a1 1 0 00.95.789h9.167l-1.358-5.435a.997.997 0 00-.01-.042L13.78 3H4.22zm1.22 10H16a1 1 0 00.95-.789l1.358-5.435A2 2 0 0020 3a2 2 0 00-2-2H4.22l-.305 1.222a.997.997 0 00-.01.042L1.357 10.789A1 1 0 001 11h2.22zm13.78 3a1 1 0 100 2 1 1 0 000-2zm-8 0a1 1 0 100 2 1 1 0 000-2z" />
                        </svg>
                        Add to Cart
                    </button>
                </div>
            </div>
        </section>

        <!-- Instrumentals Section --><section id="instrumentals" class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-5xl font-extrabold text-center mb-6 text-text-dark">The Artistry Collection</h2>
            <p class="text-xl text-center text-gray-700 mb-16 max-w-3xl mx-auto">
                Explore a curated selection of instrumentals, each a unique sonic painting designed to ignite your creativity.
            </p>

            <!-- Instrumental Cards Grid --><div id="instrumentalsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                <!-- Track cards are injected here by JavaScript --></div>
        </section>

        <!-- About/Licensing Section --><section id="about" class="py-20 md:py-28 bg-secondary-light border-y border-soft-gray">
            <div class="max-w-4xl mx-auto px-4 text-center">
                <h2 class="text-4xl font-extrabold mb-6 text-accent-watercolor">Your Vision, Our Canvas</h2>
                <p class="text-gray-700 text-lg mb-8">
                    We offer flexible licensing options that honor your creative journey, from foundational leases to full exclusive rights. Every license ensures you receive premium-quality WAV files, individual stems, and a clear, artist-friendly contract.
                </p>
                <ul class="text-gray-600 space-y-4 list-disc list-inside text-left inline-block">
                    <li>Basic Lease: For emerging artists, streaming up to 500k, 1 music video.</li>
                    <li>Premium Lease: Unlimited artistic freedom, physical releases, multiple videos.</li>
                    <li>Exclusive Rights: Complete ownership, unique sonic fingerprint, price negotiated.</li>
                </ul>
                <a href="#contact" class="mt-12 inline-block px-8 py-3 bg-accent-watercolor hover:bg-accent-dark text-white font-semibold rounded-xl transition duration-300 text-lg shadow-md">
                    Understand Our Terms
                </a>
            </div>
        </section>

        <!-- Contact Section --><section id="contact" class="py-20 md:py-28 max-w-4xl mx-auto px-4">
            <h2 class="text-5xl font-extrabold text-center mb-6 text-text-dark">Create With Us</h2>
            <p class="text-xl text-center text-gray-700 mb-16 max-w-3xl mx-auto">
                Whether for a specific project or a custom masterpiece, let's bring your auditory dreams to life.
            </p>
            
            <form class="bg-secondary-light p-10 rounded-2xl shadow-xl border border-soft-gray">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                    <div>
                        <label for="name" class="block text-md font-medium text-gray-700 mb-2">Your Name</label>
                        <input type="text" id="name" name="name" class="w-full p-4 bg-primary-light border border-soft-gray rounded-lg focus:ring-accent-watercolor focus:border-accent-watercolor transition duration-200" required>
                    </div>
                    <div>
                        <label for="email" class="block text-md font-medium text-gray-700 mb-2">Your Email</label>
                        <input type="email" id="email" name="email" class="w-full p-4 bg-primary-light border border-soft-gray rounded-lg focus:ring-accent-watercolor focus:border-accent-watercolor transition duration-200" required>
                    </div>
                </div>
                <div class="mb-8">
                    <label for="subject" class="block text-md font-medium text-gray-700 mb-2">Subject</label>
                    <select id="subject" name="subject" class="w-full p-4 bg-primary-light border border-soft-gray rounded-lg focus:ring-accent-watercolor focus:border-accent-watercolor transition duration-200">
                        <option value="licensing">Licensing Inquiry</option>
                        <option value="custom">Custom Beat Commission</option>
                        <option value="general">General Collaboration</option>
                    </select>
                </div>
                <div class="mb-10">
                    <label for="message" class="block text-md font-medium text-gray-700 mb-2">Your Message</label>
                    <textarea id="message" name="message" rows="6" class="w-full p-4 bg-primary-light border border-soft-gray rounded-lg focus:ring-accent-watercolor focus:border-accent-watercolor transition duration-200" required></textarea>
                </div>
                <button type="submit" class="w-full py-4 bg-accent-watercolor hover:bg-accent-dark text-white font-bold rounded-xl transition duration-300 shadow-lg transform hover:scale-[1.01] text-xl">
                    Send My Message
                </button>
            </form>
        </section>
    </main>

    <!-- Footer --><footer class="bg-primary-light border-t border-soft-gray mt-16 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-2xl font-extrabold tracking-wider text-text-dark mb-3">STUDIO <span class="text-accent-watercolor">34C</span></p>
            <p class="text-gray-500 text-sm">© 2025 Studio 34C. All Rights Reserved. | Crafted with <span class="text-red-500">♥</span> and creativity.</p>
        </div>
    </footer>

</body>
</html>


